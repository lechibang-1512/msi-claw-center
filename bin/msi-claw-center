def read_sysfs(path, default=""):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def kernel_lockdown_mode():
    txt = read_sysfs("/sys/kernel/security/lockdown", "")
    m = re.search(r"\[([a-zA-Z0-9_-]+)\]", txt)
    if m and m.group(1) != "none":
        return m.group(1)
    return ""


def gpu_priority_active():
    # Explicit flag set by the setup script; TuneD battery profiles also cap max_perf_pct, so the value alone is ambiguous
    max_pct = int(read_sysfs("/sys/devices/system/cpu/intel_pstate/max_perf_pct", "100") or 100)
    return os.path.exists("/run/msi-claw-gpu-priority") and max_pct <= 72


def resolve_hwmon():
    cpu_temp = "/sys/class/hwmon/hwmon5/temp1_input"
    acpitz_temp = None
    found_coretemp = False
    fan1 = "/sys/class/hwmon/hwmon4/fan1_input"
    fan2 = "/sys/class/hwmon/hwmon4/fan2_input"
    for hdir in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        name = read_sysfs(f"{hdir}/name")
        if name == "coretemp":
            if os.path.exists(f"{hdir}/temp1_input"):
                cpu_temp = f"{hdir}/temp1_input"
                found_coretemp = True
        elif name == "acpitz":
            if os.path.exists(f"{hdir}/temp1_input"):
                acpitz_temp = f"{hdir}/temp1_input"
        elif name == "msi_wmi_platform":
            if os.path.exists(f"{hdir}/fan1_input"):
                fan1 = f"{hdir}/fan1_input"
            if os.path.exists(f"{hdir}/fan2_input"):
                fan2 = f"{hdir}/fan2_input"
    if not found_coretemp and acpitz_temp:
        cpu_temp = acpitz_temp
    return cpu_temp, fan1, fan2


def resolve_arc_gpu():
    for cdir in sorted(glob.glob("/sys/class/drm/card[0-9]*")):
        dev_dir = f"{cdir}/device"
        if read_sysfs(f"{dev_dir}/vendor").lower() != "0x8086":
            continue
        drv = "unknown"
        drv_link = f"{dev_dir}/driver"
        if os.path.islink(drv_link):
            drv = os.path.basename(os.path.realpath(drv_link))
        if drv == "xe" or os.path.isdir(f"{dev_dir}/tile0/gt0"):
            return "xe", cdir
        if drv == "i915" or os.path.isdir(f"{cdir}/gt/gt0"):
            return "i915", cdir
    return "i915", "/sys/class/drm/card1"


class ClawRGBController:
    """Direct zero-flash-wear MSI Claw RGB HID controller."""

    def __init__(self):
        self.sys_dir, self.dev_path = self._find()
        self.addr = self._get_addr(self.sys_dir) if self.sys_dir else 0x024A

    @staticmethod
    def _find():
        for sdir in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
            ue = read_sysfs(f"{sdir}/device/uevent").upper()
            if "0DB0:" in ue and any(p in ue for p in CLAW_PIDS):
                try:
                    rdesc = Path(f"{sdir}/device/report_descriptor").read_bytes()
                    if rdesc.startswith(b"\x06\xa0\xff"):
                        return sdir, "/dev/" + os.path.basename(sdir)
                    continue
                except OSError:
                    pass
                real_dev = os.path.realpath(f"{sdir}/device")
                if re.search(r"/INPUT1(?:\r?\n|$)", ue) or ":1.1/" in real_dev or real_dev.endswith(":1.1"):
                    return sdir, "/dev/" + os.path.basename(sdir)
        return None, None

    @staticmethod
    def _get_addr(sdir):
        d = os.path.realpath(f"{sdir}/device")
        while d != "/" and not os.path.exists(f"{d}/bcdDevice"):
            d = os.path.dirname(d)
        bcd_txt = read_sysfs(f"{d}/bcdDevice")
        if bcd_txt:
            try:
                bcd = int(bcd_txt, 16)
                major, minor = bcd >> 8, bcd & 0xFF
                if (major == 1 and minor >= 0x66) or (major == 2 and minor >= 0x17) or major >= 3:
                    return 0x024A
                return 0x01FA
            except ValueError:
                pass
        return 0x024A

    def apply(self, r, g, b, brightness):
        if (
            not self.dev_path
            or not os.path.exists(self.dev_path)
            or not self.sys_dir
            or "0DB0:" not in read_sysfs(f"{self.sys_dir}/device/uevent").upper()
        ):
            self.sys_dir, self.dev_path = self._find()
            if self.sys_dir:
                self.addr = self._get_addr(self.sys_dir)
        if not self.dev_path:
            return False, "MSI Claw RGB hidraw device not detected"
        try:
            fd = os.open(self.dev_path, os.O_RDWR | os.O_NONBLOCK)
        except PermissionError:
            return False, f"Permission denied on {self.dev_path} (run Live Fixes to grant access)"
        except OSError as e:
            self.dev_path = None
            return False, f"Device open failed: {e.strerror}"

        try:
            try:
                while os.read(fd, 64):
                    pass
            except BlockingIOError:
                pass
            br = max(0, min(100, int(brightness)))
            rc, gc, bc = (max(0, min(255, int(v))) for v in (r, g, b))
            body = bytes([0x01, self.addr >> 8, self.addr & 0xFF, 0x24, 0x00, 1, 0x09, 0, br])
            pkt = (bytes([0x0F, 0, 0, 0x3C, 0x21]) + body + bytes([rc, gc, bc]) * 9).ljust(64, b"\x00")
            os.write(fd, pkt)
            rlist, _, _ = select.select([fd], [], [], 0.04)
            if rlist:
                try:
                    while os.read(fd, 64):
                        pass
                except BlockingIOError:
                    pass
            return True, "OK"
        except OSError as e:
            return False, f"HID write error: {e.strerror}"
        finally:
            os.close(fd)


class MSIClawCenterWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="MSI Claw Center")
        self.set_default_size(1020, 620)

        self.sys_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.ses_bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.cpu_temp_path, self.fan1_path, self.fan2_path = resolve_hwmon()
        self.gpu_drv, self.gpu_card_dir = resolve_arc_gpu()
        self.rgb_ctrl = ClawRGBController()
        self.rgb_color = (0, 170, 255)
        self.rgb_brightness = 15
        self.rgb_cfg_path = Path.home() / ".config" / "msi-claw-rgb.json"
        if self.rgb_cfg_path.exists():
            try:
                rcfg = json.loads(self.rgb_cfg_path.read_text())
                self.rgb_color = (int(rcfg.get("r", 0)), int(rcfg.get("g", 170)), int(rcfg.get("b", 255)))
                self.rgb_brightness = int(rcfg.get("brightness", 15))
            except Exception:
                pass

        self.gyro_cfg_path = Path.home() / ".config" / "msi-claw-gyro.json"
        self.gyro_enabled = True
        self.gyro_sens = 4.0
        self.gyro_mode = "lt_hold"
        self.gyro_invert_x = False
        self.gyro_invert_y = False
        if self.gyro_cfg_path.exists():
            try:
                gcfg = json.loads(self.gyro_cfg_path.read_text())
                self.gyro_enabled = bool(gcfg.get("enabled", True))
                self.gyro_sens = max(1.0, min(10.0, float(gcfg.get("sensitivity", 4.0))))
                self.gyro_mode = str(gcfg.get("mode", "lt_hold"))
                self.gyro_invert_x = bool(gcfg.get("invert_x", False))
                self.gyro_invert_y = bool(gcfg.get("invert_y", False))
            except Exception:
                pass
        self._gyro_debounce_id = 0
        self._updating_gyro_ui = False
        self._updating_cooler_ui = False

        self.keys_cfg_path = Path.home() / ".config" / "msi-claw-keys.json"
        self.default_key_cfg = {
            "view_desktop": "esc",
            "menu_desktop": "alt-tab",
            "f16_tap": "toggle-center",
            "f16_chord": "overview",
            "f15_tap": "quick-settings",
            "f15_chord": "toggle-osk",
            "m1_desktop": "toggle-osk",
            "m2_desktop": "enter",
            "m1_gamepad": "gyro-hold",
            "m2_gamepad": "toggle-osk",
            "m1_chord": "screenshot",
            "m2_chord": "toggle-gyro",
            "a_desktop": "mouse-left",
            "b_desktop": "mouse-right",
            "x_desktop": "toggle-osk",
            "y_desktop": "overview",
        }
        self.key_cfg = dict(self.default_key_cfg)
        self._load_key_bindings()
        self._updating_keys_ui = False
        self.key_dropdowns = {}

        self.current_output = "eDP-1"
        self.current_res = "1920x1080"
        self.current_scale = "1.5"
        self.current_hz = 120
        self.current_vrr = True
        self._kscreen_modes = {}
        self.bl_serial = 0
        self.bl_min = 1920
        self.bl_max = 192000
        self.kde_bl_max = 10000
        self._cached_is_plasma = None
        self._cached_is_wlroots = None
        self._bl_updating = False
        self._bl_debounce_id = 0
        self._rgb_debounce_id = 0
        self._updating_rgb_ui = False
        self._switches_updating = False

        self._last_rc6_ms = None
        self._last_rc6_ts = None
        self._timer_id = 0

        self._build_ui()
        self._connect_lifecycle()
        self._sync_initial_controls()
        self._refresh_telemetry()

    def _make_telemetry_card(self, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.add_css_class("telemetry-card")
        box.set_hexpand(True)

        lbl_t = Gtk.Label(label=title, xalign=0.0)
        lbl_t.add_css_class("telemetry-title")
        lbl_v = Gtk.Label(label="--", xalign=0.0)
        lbl_v.add_css_class("telemetry-value")
        lbl_v.set_wrap(True)
        lbl_s = Gtk.Label(label="--", xalign=0.0)
        lbl_s.add_css_class("telemetry-sub")
        lbl_s.set_wrap(True)

        box.append(lbl_t)
        box.append(lbl_v)
        box.append(lbl_s)
        return box, lbl_v, lbl_s

    def _make_key_dropdown(self, cfg_key, caption_txt, opt_list, badge_txt=None, badge_cls="key-badge"):
        cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        cell.set_hexpand(True)
        hdr_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        if badge_txt:
            b_lbl = Gtk.Label(label=badge_txt)
            b_lbl.add_css_class(badge_cls)
            hdr_row.append(b_lbl)
        lbl = Gtk.Label(label=caption_txt, xalign=0.0, wrap=True)
        lbl.add_css_class("section-caption")
        lbl.set_hexpand(True)
        hdr_row.append(lbl)

        str_list = Gtk.StringList.new([o[1] for o in opt_list])
        dd = Gtk.DropDown(model=str_list)
        dd.set_hexpand(True)
        cur_val = self.key_cfg.get(cfg_key, self.default_key_cfg.get(cfg_key, ""))
        sel_i = 0
        for oi, (oval, _) in enumerate(opt_list):
            if oval == cur_val:
                sel_i = oi
                break
        dd.set_selected(sel_i)
        dd.connect("notify::selected", self._on_key_dropdown_changed, cfg_key, opt_list)
        self.key_dropdowns[cfg_key] = (dd, opt_list)

        cell.append(hdr_row)
        cell.append(dd)
        return cell

    def _switch_tab(self, tab_name):
        self.view_stack.set_visible_child_name(tab_name)
        for tname, tbtn in self.nav_tab_buttons.items():
            if tname == tab_name:
                tbtn.add_css_class("active-tab")
            else:
                tbtn.remove_css_class("active-tab")

    def _toggle_controller_mode_quick(self):
        cur = read_sysfs(f"/dev/shm/msi-claw-mode-{os.getuid()}", "desktop")
        self._set_controller_mode("gamepad" if cur == "desktop" else "desktop")

    def _build_ui(self):
        self.toast_overlay = Adw.ToastOverlay()
        toolbar = Adw.ToolbarView()

        # --- Header Bar with Integrated 3-Tab Switcher ---
        header = Adw.HeaderBar()

        left_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        osk_hdr_btn = Gtk.Button(icon_name="input-keyboard-symbolic", tooltip_text="Toggle On-Screen Keyboard")
        osk_hdr_btn.connect("clicked", lambda *_: self._send_claw_cmd("toggle-osk"))
        left_hdr.append(osk_hdr_btn)

        self.power_badge = Gtk.Label(label="AC Power")
        self.power_badge.add_css_class("badge-ac")
        left_hdr.append(self.power_badge)
        header.pack_start(left_hdr)

        # Center Segmented Navigation Bar
        nav_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        nav_bar.add_css_class("nav-tab-bar")
        self.nav_tab_buttons = {}
        for tname, tlabel, ttip in [
            ("perf", "⚡ Power & Display", "Performance, RAPL TDP, Display VRR & Battery Care (Key 1)"),
            ("keys", "🎮 4-Key & Paddles", "4 Front Buttons, Rear M1/M2 Paddles & Desktop ABXY Remap (Key 2)"),
            ("sys", "🌈 RGB & System", "Zero-Flash-Wear RGB Studio, Fingerprint & Diagnostics (Key 3)"),
        ]:
            tbtn = Gtk.Button(label=tlabel, tooltip_text=ttip)
            tbtn.add_css_class("nav-tab-btn")
            tbtn.connect("clicked", lambda _b, n=tname: self._switch_tab(n))
            nav_bar.append(tbtn)
            self.nav_tab_buttons[tname] = tbtn
        header.set_title_widget(nav_bar)

        # Right Header Quick Controls
        self.hdr_mode_btn = Gtk.Button(label="🖱️ Desktop", tooltip_text="Quick-Switch Desktop / Gamepad Mode (View + Menu)")
        self.hdr_mode_btn.add_css_class("pill-btn")
        self.hdr_mode_btn.connect("clicked", lambda *_: self._toggle_controller_mode_quick())

        refresh_btn = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh Telemetry")
        refresh_btn.connect("clicked", lambda *_: self._refresh_telemetry())

        about_btn = Gtk.Button(icon_name="help-about-symbolic", tooltip_text="About & GitHub Repository")
        about_btn.connect("clicked", self._on_show_about)

        header.pack_end(about_btn)
        header.pack_end(refresh_btn)
        header.pack_end(self.hdr_mode_btn)
        toolbar.add_top_bar(header)

        # --- Main Vertical Layout: Pinned Telemetry Ribbon + Tabbed View Stack ---
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        # Persistent 4-Card Telemetry Ribbon (Always visible across all tabs)
        ribbon_wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        ribbon_wrap.add_css_class("telemetry-ribbon")
        self.t_grid = Gtk.Grid(column_spacing=8, row_spacing=6, column_homogeneous=True)
        self.card_bat, self.bat_val, self.bat_sub = self._make_telemetry_card("BATTERY & POWER")
        self.card_cpu, self.cpu_val, self.cpu_sub = self._make_telemetry_card("CPU & RAPL TDP")
        self.card_gpu, self.gpu_val, self.gpu_sub = self._make_telemetry_card("INTEL ARC GPU")
        self.card_fan, self.fan_val, self.fan_sub = self._make_telemetry_card("FANS & DISPLAY")

        self.t_grid.attach(self.card_bat, 0, 0, 1, 1)
        self.t_grid.attach(self.card_cpu, 1, 0, 1, 1)
        self.t_grid.attach(self.card_gpu, 2, 0, 1, 1)
        self.t_grid.attach(self.card_fan, 3, 0, 1, 1)
        ribbon_wrap.append(self.t_grid)
        main_vbox.append(ribbon_wrap)

        # Stack for the 3 Views
        self.view_stack = Gtk.Stack(
            transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
            transition_duration=160,
        )
        self.view_stack.set_vexpand(True)
        self.view_stack.set_hexpand(True)

        # =====================================================================
        # TAB 1: ⚡ PERFORMANCE, DISPLAY & BATTERY CARE
        # =====================================================================
