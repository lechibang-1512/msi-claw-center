#!/usr/bin/env python3
"""
MSI Claw A1M Battery Charge Threshold Controller (1T41EMS1.108 / msi-wmi-platform).
Uses the in-kernel msi-wmi-platform driver's locked 32-byte WMI get_data (0x1b) & set_data (0x1c)
methods on EC register 0xD7 (value = 0x80 + percentage, range 50..100%).
"""
import glob
import os
import re
import subprocess
import sys
from pathlib import Path

EC_CHARGE_REG = 0xD7
EC_OFFSET = 0x80
RUN_STATE = Path("/run/msi-claw-charge-limit")
PERSIST_DIR = Path("/var/lib/msi-claw")
PERSIST_STATE = PERSIST_DIR / "charge-limit"


def kernel_lockdown_mode() -> str:
    try:
        txt = Path("/sys/kernel/security/lockdown").read_text().strip()
        m = re.search(r"\[([a-zA-Z0-9_-]+)\]", txt)
        if m and m.group(1) != "none":
            return m.group(1)
    except OSError:
        pass
    return ""


def find_wmi_dir():
    dirs = sorted(glob.glob("/sys/kernel/debug/msi-wmi-platform-*"))
    if not dirs:
        subprocess.run(["/usr/sbin/modprobe", "msi_wmi_platform"], check=False)
        dirs = sorted(glob.glob("/sys/kernel/debug/msi-wmi-platform-*"))
    return Path(dirs[0]) if dirs else None


def wmi_read_ec(wmi_dir: Path, addr: int) -> int:
    get_data = wmi_dir / "get_data"
    pkt = bytes([addr & 0xFF]) + (b"\x00" * 31)
    with open(get_data, "wb") as wf:
        wf.write(pkt)
    with open(get_data, "rb") as rf:
        resp = rf.read(32)
    if len(resp) < 2 or resp[0] == 0:
        raise RuntimeError(f"WMI get_data(0x{addr:02x}) failed: {resp.hex(' ')}")
    return resp[1]


def wmi_write_ec(wmi_dir: Path, addr: int, val: int) -> None:
    set_data = wmi_dir / "set_data"
    pkt = bytes([addr & 0xFF, val & 0xFF]) + (b"\x00" * 30)
    with open(set_data, "wb") as wf:
        wf.write(pkt)
    with open(set_data, "rb") as rf:
        resp = rf.read(32)
    if len(resp) < 1 or resp[0] == 0:
        raise RuntimeError(f"WMI set_data(0x{addr:02x}, 0x{val:02x}) failed: {resp.hex(' ')}")


def write_atomic(path: Path, text: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    tmp.write_text(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def read_limit(wmi_dir: Path) -> int:
    raw = wmi_read_ec(wmi_dir, EC_CHARGE_REG)
    if raw in (0x00, 0x80):
        pct = 100
    else:
        pct = raw - EC_OFFSET
    if not (50 <= pct <= 100):
        raise RuntimeError(f"Unexpected EC[0xD7]=0x{raw:02x} (decoded {pct}%, expected 50..100%)")
    write_atomic(RUN_STATE, f"{pct}\n", 0o644)
    return pct


def set_limit(wmi_dir: Path, pct: int, persist: bool = True) -> int:
    if not (50 <= pct <= 100):
        raise ValueError("Battery charge limit must be between 50 and 100")
    # Sanity-check register before writing
    _ = read_limit(wmi_dir)
    target_raw = EC_OFFSET + pct
    wmi_write_ec(wmi_dir, EC_CHARGE_REG, target_raw)
    verified = read_limit(wmi_dir)
    if verified != pct:
        raise RuntimeError(f"Readback mismatch: wrote {pct}%, got {verified}%")
    if persist:
        write_atomic(PERSIST_STATE, f"{pct}\n", 0o644)
    return verified


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    if os.geteuid() != 0:
        print("Error: msi-claw-battery-limit must be run as root (e.g. via pkexec)", file=sys.stderr)
        return 1
    wmi_dir = find_wmi_dir()
    if wmi_dir is None:
        lk = kernel_lockdown_mode()
        if lk and cmd == "restore":
            print(
                f"Notice: Skipping EC charge-limit restore under Secure Boot Kernel Lockdown ({lk}); "
                f"msi-wmi-platform debugfs is unavailable.",
                file=sys.stderr,
            )
            return 0
        if lk:
            print(
                f"Error: Blocked by Secure Boot Kernel Lockdown ({lk}): msi-wmi-platform debugfs not available",
                file=sys.stderr,
            )
            return 1
        print("msi-wmi-platform debugfs not available", file=sys.stderr)
        return 1

    try:
        if cmd == "get":
            pct = read_limit(wmi_dir)
            print(pct)
            return 0
        elif cmd == "set":
            if len(sys.argv) < 3:
                print("Usage: msi-claw-battery-limit set <50..100>", file=sys.stderr)
                return 2
            pct = int(sys.argv[2])
            verified = set_limit(wmi_dir, pct, persist=True)
            print(f"OK {verified}%")
            return 0
        elif cmd == "restore":
            if PERSIST_STATE.exists():
                try:
                    saved = int(PERSIST_STATE.read_text().strip())
                    if 50 <= saved <= 100:
                        verified = set_limit(wmi_dir, saved, persist=False)
                        print(f"Restored {verified}%")
                        return 0
                except ValueError:
                    pass
            pct = read_limit(wmi_dir)
            print(f"Synced {pct}%")
            return 0
        else:
            # Allow shorthand: msi-claw-battery-limit 80
            pct = int(cmd)
            verified = set_limit(wmi_dir, pct, persist=True)
            print(f"OK {verified}%")
            return 0
    except PermissionError as exc:
        lk = kernel_lockdown_mode()
        if lk:
            if cmd == "restore":
                print(
                    f"Notice: Skipping EC charge-limit restore under Secure Boot Kernel Lockdown ({lk}); "
                    f"msi-wmi-platform debugfs access is restricted by the kernel.",
                    file=sys.stderr,
                )
                return 0
            print(
                f"Error: Blocked by Secure Boot Kernel Lockdown ({lk}): msi-wmi-platform debugfs is restricted ({exc})",
                file=sys.stderr,
            )
            return 1
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
