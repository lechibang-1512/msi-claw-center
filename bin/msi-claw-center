        # --- RIGHT CARD 2: Zero-Flash-Wear RGB Studio ---
        rgb_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        rgb_card.add_css_class("section-card")
        rgb_hdr = Gtk.Label(label="Thumbstick & ABXY RGB Studio", xalign=0.0)
        rgb_hdr.add_css_class("section-heading")
        rgb_sub = Gtk.Label(
            label="Direct HID streaming without ROM flash wear — turning Off saves ~0.8W on battery",
            xalign=0.0,
            wrap=True,
        )
        rgb_sub.add_css_class("section-caption")
        rgb_card.append(rgb_hdr)
        rgb_card.append(rgb_sub)

        preset_grid = Gtk.Grid(column_spacing=6, row_spacing=6, column_homogeneous=True)
        rgb_presets = [
            ("Off (0W)", (0, 0, 0), 0),
            ("Cyan", (0, 170, 255), 35),
            ("MSI Red", (255, 30, 30), 65),
            ("Purple", (175, 50, 255), 55),
            ("Green", (16, 220, 100), 50),
            ("Amber", (255, 145, 0), 50),
        ]
        for idx, (pname, col, br) in enumerate(rgb_presets):
            pb = Gtk.Button(label=pname)
            pb.add_css_class("pill-btn")
            pb.connect("clicked", self._on_rgb_preset, col, br)
            preset_grid.attach(pb, idx % 3, idx // 3, 1, 1)
        rgb_card.append(preset_grid)

        rgb_ctrl_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        color_dialog = Gtk.ColorDialog(with_alpha=False)
        init_rgba = Gdk.RGBA()
        init_rgba.parse("rgb(0,170,255)")
        self.color_btn = Gtk.ColorDialogButton(dialog=color_dialog, rgba=init_rgba)
        self.color_btn.connect("notify::rgba", self._on_custom_color_picked)

        self.rgb_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.rgb_scale.set_value(15)
        self.rgb_scale.set_draw_value(False)
        self.rgb_scale.set_hexpand(True)
        self.rgb_pct_lbl = Gtk.Label(label="15%", width_chars=5, xalign=1.0)
        self.rgb_scale.connect("value-changed", self._on_rgb_brightness_changed)

        rgb_ctrl_row.append(self.color_btn)
        rgb_ctrl_row.append(self.rgb_scale)
        rgb_ctrl_row.append(self.rgb_pct_lbl)
        rgb_card.append(rgb_ctrl_row)
        self.right_col.append(rgb_card)

        # --- RIGHT CARD 3: System Diagnostics & Actions ---
        sys_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sys_card.add_css_class("section-card")
        sys_hdr = Gtk.Label(label="System Power Tuning & Diagnostics", xalign=0.0)
        sys_hdr.add_css_class("section-heading")
        self.sys_status_lbl = Gtk.Label(
            label="Detecting hardware configuration...",
            xalign=0.0,
            wrap=True,
        )
        self.sys_status_lbl.add_css_class("section-caption")
        sys_card.append(sys_hdr)
        sys_card.append(self.sys_status_lbl)

        fprint_btn = Gtk.Button(label="Enroll Fingerprint (Goodix MOC)")
        fprint_btn.add_css_class("pill-btn")
        fprint_btn.connect("clicked", self._on_enable_fingerprint)
        sys_card.append(fprint_btn)

        live_fix_btn = Gtk.Button(label="Apply Live Power & Input Fixes")
        live_fix_btn.add_css_class("pill-btn")
        live_fix_btn.add_css_class("active-mode")
        live_fix_btn.connect("clicked", self._on_apply_live_fixes)
        sys_card.append(live_fix_btn)

        reapply_btn = Gtk.Button(label="Re-Apply Full System Setup & GDM OSK")
        reapply_btn.add_css_class("pill-btn")
        reapply_btn.connect("clicked", self._on_reapply_system_setup)
        sys_card.append(reapply_btn)

        self.repo_btn = Gtk.Button(label=self._get_repo_button_label())
        self.repo_btn.add_css_class("pill-btn")
        self.repo_btn.connect("clicked", self._on_open_repo)
        sys_card.append(self.repo_btn)
        self.right_col.append(sys_card)

        # Attach columns
        self.cols_grid.attach(self.left_col, 0, 0, 1, 1)
        self.cols_grid.attach(self.right_col, 1, 0, 1, 1)
        root.append(self.cols_grid)

        scroll.set_child(root)
        toolbar.set_content(scroll)
        self.toast_overlay.set_child(toolbar)
        self.set_content(self.toast_overlay)

        # Breakpoint for small viewports / 2.0x scale (width < 800px)
        self._setup_breakpoint()

        # Keyboard controller (Escape/q to hide/close)
        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self._on_key_pressed)
        self.add_controller(key_ctrl)

    def _setup_breakpoint(self):
        try:
            bp = Adw.Breakpoint.new(Adw.breakpoint_condition_parse("max-width: 800sp"))
            # In narrow mode, rearrange telemetry to 2x2 grid
            bp.add_setter(self.t_grid, "column-homogeneous", True)
            self.add_breakpoint(bp)
        except Exception:
            pass

    def _on_key_pressed(self, _controller, keyval, _keycode, state):
        if keyval in (Gdk.KEY_Escape, Gdk.KEY_q, Gdk.KEY_Q, Gdk.KEY_F16):
            self.close()
            return True
        return False

    def _toast(self, msg):
        toast = Adw.Toast.new(msg)
        toast.set_use_markup(False)
        toast.set_timeout(2)
        self.toast_overlay.add_toast(toast)

    def _connect_lifecycle(self):
        self.connect("map", lambda *_: self._start_polling())
        self.connect("unmap", lambda *_: self._stop_polling())
        self.connect("close-request", self._on_close_request)

    def _on_close_request(self, _win):
        self._stop_polling()
        self.set_visible(False)
        return True

    def _start_polling(self):
        try:
            self.repo_btn.set_label(self._get_repo_button_label())
        except Exception:
            pass
        if self._timer_id == 0:
            self._refresh_telemetry()
            self._timer_id = GLib.timeout_add(2000, self._on_timer_tick)

    def _stop_polling(self):
        if self._timer_id != 0:
            GLib.source_remove(self._timer_id)
            self._timer_id = 0

    def _on_timer_tick(self):
        if not self.get_mapped():
            self._timer_id = 0
            return GLib.SOURCE_REMOVE
        self._refresh_telemetry()
        return GLib.SOURCE_CONTINUE

    def _sync_initial_controls(self):
        self._switches_updating = True
        try:
            self._rgb_debounce_set_ui(self.rgb_color, self.rgb_brightness)
        except Exception:
            pass
        try:
            if self._is_plasma():
                pd_txt = read_sysfs(str(Path.home() / ".config" / "powerdevilrc"), "")
                idle_ok = "AutoSuspendIdleTimeoutSec=300" in pd_txt or "AutoSuspendAction=0" in pd_txt
                self.fast_idle_switch.set_active(idle_ok)
            else:
                sess = Gio.Settings.new("org.gnome.desktop.session")
                pwr = Gio.Settings.new("org.gnome.settings-daemon.plugins.power")
                ts = Gio.Settings.new("org.gnome.settings-daemon.peripherals.touchscreen")
                ss = Gio.Settings.new("org.gnome.desktop.screensaver")
                idle_ok = sess.get_uint("idle-delay") <= 120 and pwr.get_int("sleep-inactive-battery-timeout") <= 300
                self.fast_idle_switch.set_active(idle_ok)
                self.orient_switch.set_active(ts.get_boolean("orientation-lock"))
                self.instant_wake_switch.set_active(not ss.get_boolean("lock-enabled"))
        except Exception:
            pass
        self._switches_updating = False
        self._sync_backlight()
        self._sync_display()

    def _is_plasma(self):
        return (
            os.environ.get("XDG_CURRENT_DESKTOP") == "KDE"
            or "plasma" in os.environ.get("DESKTOP_SESSION", "").lower()
            or os.system("pgrep -x kwin_wayland >/dev/null 2>&1") == 0
        )

    def _sync_backlight(self):
        # 1. Try GNOME Mutter DisplayConfig
        try:
            res = self.ses_bus.call_sync(
                "org.gnome.Mutter.DisplayConfig",
                "/org/gnome/Mutter/DisplayConfig",
                "org.freedesktop.DBus.Properties",
                "Get",
                GLib.Variant("(ss)", ("org.gnome.Mutter.DisplayConfig", "Backlight")),
                GLib.VariantType.new("(v)"),
                Gio.DBusCallFlags.NONE,
                250,
                None,
            )
            serial, items = res.unpack()[0]
            self.bl_serial = serial
            for item in items:
                if item.get("connector") == "eDP-1":
                    self.bl_min = int(item.get("min", 1920))
                    self.bl_max = int(item.get("max", 192000))
                    val = int(item.get("value", 9600))
                    pct = round(((val - self.bl_min) / max(1, self.bl_max - self.bl_min)) * 99 + 1)
                    pct = max(1, min(100, pct))
                    self._bl_updating = True
                    self.bl_scale.set_value(pct)
                    self.bl_pct_lbl.set_label(f"{pct}%")
                    self._bl_updating = False
                    return
        except Exception:
            pass

        # 2. Try KDE Solid PowerManagement
        try:
            res = self.ses_bus.call_sync(
                "org.kde.Solid.PowerManagement",
                "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
                "org.kde.Solid.PowerManagement.Actions.BrightnessControl",
                "brightness",
                None,
                None,
                Gio.DBusCallFlags.NONE,
                250,
                None,
            )
            val = int(res.unpack()[0])
            res_max = self.ses_bus.call_sync(
                "org.kde.Solid.PowerManagement",
                "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
                "org.kde.Solid.PowerManagement.Actions.BrightnessControl",
                "brightnessMax",
                None,
                None,
                Gio.DBusCallFlags.NONE,
                250,
                None,
            )
            mx = int(res_max.unpack()[0])
            pct = max(1, min(100, round(val * 100 / max(1, mx))))
            self._bl_updating = True
            self.bl_scale.set_value(pct)
            self.bl_pct_lbl.set_label(f"{pct}%")
            self._bl_updating = False
            return
        except Exception:
            pass

        # 3. Fallback to sysfs
        raw = int(read_sysfs("/sys/class/backlight/intel_backlight/brightness", "9600") or 9600)
        mx = int(read_sysfs("/sys/class/backlight/intel_backlight/max_brightness", "192000") or 192000)
        pct = max(1, min(100, round(raw * 100 / max(1, mx))))
        self._bl_updating = True
        self.bl_scale.set_value(pct)
        self.bl_pct_lbl.set_label(f"{pct}%")
        self._bl_updating = False

    def _on_brightness_changed(self, scale):
        if self._bl_updating:
            return
        pct = int(round(scale.get_value()))
        self.bl_pct_lbl.set_label(f"{pct}%")
        if self._bl_debounce_id:
            GLib.source_remove(self._bl_debounce_id)
        self._bl_debounce_id = GLib.timeout_add(30, self._commit_brightness, pct)

    def _commit_brightness(self, pct):
        self._bl_debounce_id = 0

        # 1. Try KDE Solid PowerManagement
        if self._is_plasma():
            try:
                self.ses_bus.call(
                    "org.kde.Solid.PowerManagement",
                    "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
                    "org.kde.Solid.PowerManagement.Actions.BrightnessControl",
                    "setBrightness",
                    GLib.Variant("(i)", (int(pct * 100),)),
                    None,
                    Gio.DBusCallFlags.NONE,
                    250,
                    None,
                    lambda b, r: (b.call_finish(r) if b else None),
                )
                return GLib.SOURCE_REMOVE
            except Exception:
                pass

        # 2. Try GNOME Mutter SetBacklight
        raw = int(round(self.bl_min + ((pct - 1) / 99.0) * (self.bl_max - self.bl_min)))
        raw = max(self.bl_min, min(self.bl_max, raw))

        def on_got_serial(bus, res):
            try:
                reply = bus.call_finish(res)
                serial = reply.unpack()[0][0]
                self.bl_serial = serial
                self.ses_bus.call(
                    "org.gnome.Mutter.DisplayConfig",
                    "/org/gnome/Mutter/DisplayConfig",
                    "org.gnome.Mutter.DisplayConfig",
                    "SetBacklight",
                    GLib.Variant("(usi)", (self.bl_serial, "eDP-1", raw)),
                    None,
                    Gio.DBusCallFlags.NONE,
                    300,
                    None,
                    lambda _b, r: (bus.call_finish(r) if bus else None),
                )
            except Exception:
                pass

        try:
            self.ses_bus.call(
                "org.gnome.Mutter.DisplayConfig",
                "/org/gnome/Mutter/DisplayConfig",
                "org.freedesktop.DBus.Properties",
                "Get",
                GLib.Variant("(ss)", ("org.gnome.Mutter.DisplayConfig", "Backlight")),
                GLib.VariantType.new("(v)"),
                Gio.DBusCallFlags.NONE,
                300,
                None,
                on_got_serial,
            )
        except Exception:
            pass
        return GLib.SOURCE_REMOVE

    def _sync_display(self):
        if self._is_plasma():
            self._sync_display_from_kscreen()
        else:
            self._sync_display_from_gdctl()

    def _sync_display_from_kscreen(self):
        try:
            proc = Gio.Subprocess.new(
                ["kscreen-doctor", "-j"],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.communicate_utf8_async(None, None, self._on_kscreen_show_done)
        except Exception:
            pass

    def _on_kscreen_show_done(self, proc, res):
        try:
            ok, stdout, _ = proc.communicate_utf8_finish(res)
            if not stdout:
                return
            data = json.loads(stdout)
            outputs = data.get("outputs", [])
            if not outputs:
                return
            enabled_outs = [o for o in outputs if o.get("enabled")]
            edp_out = next((o for o in outputs if str(o.get("name", "")).startswith("eDP")), None)
            out = next((o for o in enabled_outs if not str(o.get("name", "")).startswith("eDP")), None) or (
                enabled_outs[0] if enabled_outs else outputs[0]
            )
            conn_name = str(out.get("name", "eDP-1"))
            self.current_scale = str(out.get("scale", 1.5)).rstrip("0").rstrip(".")
            cur_id = str(out.get("currentModeId"))
            exact_hz = 120
            for m in out.get("modes", []):
                if str(m.get("id")) == cur_id:
                    w = m.get("size", {}).get("width", 1920)
                    h = m.get("size", {}).get("height", 1080)
                    exact_hz = round(m.get("refreshRate", 120))
                    self.current_res = f"{w}x{h}"
                    self.current_hz = 60 if exact_hz < 90 else 120
                    break
            vrr_policy = out.get("vrrPolicy", 0)
            vrr_capable = (out.get("capabilities", 0) & 2) != 0 if isinstance(out.get("capabilities"), int) else True
            self.current_vrr = (vrr_policy != 0) and vrr_capable
            if not conn_name.startswith("eDP"):
                edp_state = "eDP-1 Off" if (edp_out and not edp_out.get("enabled")) else "Dual"
                self.fan_sub.set_label(f"{conn_name}: {self.current_res}@{exact_hz}Hz · {edp_state}")
            else:
                vrr_txt = "+VRR" if self.current_vrr else "Fixed"
                self.fan_sub.set_label(f"{self.current_res} @ {exact_hz}Hz {vrr_txt} · {self.current_scale}x")
            self._update_display_highlights()
        except Exception:
            pass

    def _sync_display_from_gdctl(self):
        try:
            proc = Gio.Subprocess.new(
                ["gdctl", "show"],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.communicate_utf8_async(None, None, self._on_gdctl_show_done)
        except Exception:
            pass

    def _on_gdctl_show_done(self, proc, res):
        try:
            ok, stdout, _ = proc.communicate_utf8_finish(res)
            if not stdout:
                return
            sc_m = re.search(r"Scale:\s*([0-9.]+)", stdout)
            if sc_m:
                sc_val = sc_m.group(1).rstrip("0").rstrip(".") if "." in sc_m.group(1) else sc_m.group(1)
                self.current_scale = sc_val

            hz_m = re.search(r"Current mode[\s\S]*?([0-9]+x[0-9]+)@([0-9.]+)", stdout) or re.search(
                r"([0-9]+x[0-9]+)@([0-9.]+)", stdout
            )
            res_txt = self.current_res
            if hz_m:
                res_txt = hz_m.group(1)
                self.current_res = res_txt
                hz_f = float(hz_m.group(2))
                self.current_hz = 60 if hz_f < 90 else 120

            self.current_vrr = "variable" in stdout.lower() or "+vrr" in stdout.lower()
            vrr_txt = "+VRR" if self.current_vrr else "Fixed"
            self.fan_sub.set_label(f"{res_txt} @ {self.current_hz}Hz {vrr_txt} · {self.current_scale}x")
            self._update_display_highlights()
        except Exception:
            pass

    def _update_display_highlights(self):
        if self.current_hz == 60:
            self.btn_60hz.add_css_class("eco-active")
            self.btn_120hz.remove_css_class("active-mode")
            self.btn_fixed.remove_css_class("active-mode")
        elif self.current_vrr:
            self.btn_60hz.remove_css_class("eco-active")
            self.btn_120hz.add_css_class("active-mode")
            self.btn_fixed.remove_css_class("active-mode")
        else:
            self.btn_60hz.remove_css_class("eco-active")
            self.btn_120hz.remove_css_class("active-mode")
            self.btn_fixed.add_css_class("active-mode")

        for sc, btn in self.scale_buttons.items():
            if sc == self.current_scale:
                btn.add_css_class("active-mode")
            else:
                btn.remove_css_class("active-mode")

    def _apply_display(self, hz, scale, vrr=True):
        self.current_hz = hz
        self.current_scale = str(scale)
        self.current_vrr = vrr
        self._update_display_highlights()
        res_txt = self.current_res or "1920x1080"

        if self._is_plasma():
            vrr_pol = "automatic" if vrr else "never"
            cmd = [
                "kscreen-doctor",
                f"output.eDP-1.mode.{res_txt}@{hz}",
                f"output.eDP-1.scale.{scale}",
                f"output.eDP-1.vrrpolicy.{vrr_pol}",
            ]
            try:
                proc = Gio.Subprocess.new(
                    cmd,
                    Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
                )
                proc.wait_check_async(
                    None,
                    lambda p, r: (
                        self._toast(
                            f"Applied {res_txt} @ {hz} Hz {'+ VRR' if vrr else 'Fixed'} ({scale}x)"
                            if self._finish_ok(p, r)
                            else f"Display mode {res_txt}@{hz} rejected by KScreen"
                        ),
                        self._sync_display(),
                    ),
                )
            except Exception as e:
                self._toast(f"Display error: {e}")
            return

        # GNOME gdctl path
        suffix = "+vrr" if vrr else ""
        if res_txt == "1600x900":
            mode = f"1600x900@{59.946 if hz == 60 else 119.948}{suffix}"
        elif res_txt == "1280x720":
            mode = f"1280x720@{59.855 if hz == 60 else 119.858}{suffix}"
        else:
            mode = f"1920x1080@{60.004 if hz == 60 else 120.003}{suffix}"

        try:
            proc = Gio.Subprocess.new(
                [
                    "gdctl",
                    "set",
                    "--persistent",
                    "--logical-monitor",
                    "--primary",
                    "--scale",
                    str(scale),
                    "--monitor",
                    "eDP-1",
                    "--mode",
                    mode,
                ],
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.wait_check_async(
                None,
                lambda p, r: (
                    self._toast(
                        f"Applied {res_txt} @ {hz} Hz {'+ VRR' if vrr else 'Fixed'} ({scale}x)"
                        if self._finish_ok(p, r)
                        else f"Display mode {mode} @ {scale}x rejected by Mutter"
                    ),
                    self._sync_display(),
                ),
            )
        except Exception as e:
            self._toast(f"Display error: {e}")

    def _on_power_profile_clicked(self, _btn, profile):
        try:
            variant = GLib.Variant(
                "(ssv)",
                ("org.freedesktop.UPower.PowerProfiles", "ActiveProfile", GLib.Variant("s", profile)),
            )

            def on_profile_set(bus, res):
                try:
                    bus.call_finish(res)
                    self._toast(f"Switched to {profile}")
                except Exception as e:
                    self._toast(f"Profile switch failed: {e}")
                GLib.timeout_add(350, lambda: (self._refresh_telemetry(), GLib.SOURCE_REMOVE)[1])

            self.sys_bus.call(
                "org.freedesktop.UPower.PowerProfiles",
                "/org/freedesktop/UPower/PowerProfiles",
                "org.freedesktop.DBus.Properties",
                "Set",
                variant,
                None,
                Gio.DBusCallFlags.NONE,
                1000,
                None,
                on_profile_set,
            )
            self._update_power_highlights(profile)
        except Exception as e:
            self._toast(f"Profile switch failed: {e}")

    def _update_power_highlights(self, active):
        for prof, btn in self.power_buttons.items():
            btn.remove_css_class("eco-active")
            btn.remove_css_class("active-mode")
            btn.remove_css_class("perf-active")
            if prof == active:
                if prof == "power-saver":
                    btn.add_css_class("eco-active")
                elif prof == "performance":
                    btn.add_css_class("perf-active")
                else:
                    btn.add_css_class("active-mode")

    def _send_claw_cmd(self, cmd):
        rdir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        tmp_path = f"{rdir}/.msi-claw-cmd.{os.getpid()}"
        dst_path = f"{rdir}/msi-claw-cmd"
        try:
            Path(tmp_path).write_text(f"{cmd}\n")
            os.replace(tmp_path, dst_path)
        except OSError:
            pass

    def _set_controller_mode(self, target):
        self._send_claw_cmd(f"mode-{target}")
        self._toast(f"Controller: {'Desktop Mouse/Kbd' if target == 'desktop' else 'Xbox Gamepad'}")
        GLib.timeout_add(250, lambda: (self._refresh_controller_mode(), GLib.SOURCE_REMOVE)[1])

    def _refresh_controller_mode(self):
        mode = read_sysfs(f"/dev/shm/msi-claw-mode-{os.getuid()}", "desktop")
        if mode == "gamepad":
            self.btn_mode_gamepad.add_css_class("perf-active")
            self.btn_mode_desktop.remove_css_class("active-mode")
        else:
            self.btn_mode_desktop.add_css_class("active-mode")
            self.btn_mode_gamepad.remove_css_class("perf-active")

    def _save_handheld_rgb_pref(self, color, brightness):
        dock_raw = read_sysfs(f"/dev/shm/msi-claw-dock-{os.getuid()}", "handheld")
        # Save handheld RGB preference whenever brightness > 0, or if explicitly set to Off while handheld
        if brightness > 0 or not dock_raw.startswith("docked"):
            try:
                self.rgb_cfg_path.parent.mkdir(parents=True, exist_ok=True)
                self.rgb_cfg_path.write_text(
                    json.dumps({"r": color[0], "g": color[1], "b": color[2], "brightness": brightness}) + "\n"
                )
            except OSError:
                pass

    def _on_rgb_preset(self, _btn, color, brightness):
        self.rgb_color = color
        self.rgb_brightness = brightness
        self._save_handheld_rgb_pref(color, brightness)
        self._rgb_debounce_set_ui(color, brightness)
        ok, msg = self.rgb_ctrl.apply(color[0], color[1], color[2], brightness)
        if not ok:
            self._toast(msg)
        elif brightness == 0:
            self._toast("RGB Off (Saving ~0.8W)")
        else:
            self._toast("Controller RGB Updated")

    def _rgb_debounce_set_ui(self, color, brightness):
        self._updating_rgb_ui = True
        try:
            rgba = Gdk.RGBA()
            rgba.red, rgba.green, rgba.blue, rgba.alpha = color[0] / 255.0, color[1] / 255.0, color[2] / 255.0, 1.0
            self.color_btn.set_rgba(rgba)
            self.rgb_scale.set_value(brightness)
            self.rgb_pct_lbl.set_label(f"{brightness}%")
        finally:
            self._updating_rgb_ui = False

    def _on_custom_color_picked(self, btn, _pspec):
        if self._updating_rgb_ui:
            return
        rgba = btn.get_rgba()
        self.rgb_color = (round(rgba.red * 255), round(rgba.green * 255), round(rgba.blue * 255))
        if self.rgb_brightness == 0:
            self._updating_rgb_ui = True
            self.rgb_brightness = 50
            self.rgb_scale.set_value(50)
            self.rgb_pct_lbl.set_label("50%")
            self._updating_rgb_ui = False
        self._schedule_rgb_apply()

    def _on_rgb_brightness_changed(self, scale):
        if self._updating_rgb_ui:
            return
        br = int(round(scale.get_value()))
        self.rgb_brightness = br
        self.rgb_pct_lbl.set_label(f"{br}%")
        if br > 0 and self.rgb_color == (0, 0, 0):
            self.rgb_color = (0, 170, 255)
        self._schedule_rgb_apply()

    def _schedule_rgb_apply(self):
        if self._rgb_debounce_id:
            GLib.source_remove(self._rgb_debounce_id)
        self._rgb_debounce_id = GLib.timeout_add(35, self._commit_rgb)

    def _commit_rgb(self):
        self._rgb_debounce_id = 0
        r, g, b = self.rgb_color
        self._save_handheld_rgb_pref(self.rgb_color, self.rgb_brightness)
        self.rgb_ctrl.apply(r, g, b, self.rgb_brightness)
        return GLib.SOURCE_REMOVE

    @staticmethod
    def _finish_ok(proc, res):
        try:
            return proc.wait_check_finish(res)
        except Exception:
            return False

    def _on_fast_idle_toggled(self, _sw, state):
        if self._switches_updating:
            return False
        if self._is_plasma():
            bat_blank = 120 if state else 300
            bat_sleep = 300 if state else 900
            for grp, key, val in [
                (("AC", "SuspendAndShutdown"), "AutoSuspendAction", "0"),
                (("AC", "Display"), "TurnOffDisplayIdleTimeoutSec", "600"),
                (("Battery", "Display"), "TurnOffDisplayIdleTimeoutSec", str(bat_blank)),
                (("Battery", "SuspendAndShutdown"), "AutoSuspendAction", "1"),
                (("Battery", "SuspendAndShutdown"), "AutoSuspendIdleTimeoutSec", str(bat_sleep)),
            ]:
                cmd = ["kwriteconfig6", "--file", "powerdevilrc"]
                for g in grp:
                    cmd.extend(["--group", g])
                cmd.extend(["--key", key, val])
                subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            try:
                self.ses_bus.call_sync(
                    "org.kde.Solid.PowerManagement",
                    "/org/kde/Solid/PowerManagement",
                    "org.kde.Solid.PowerManagement",
                    "reparseConfiguration",
                    None,
                    None,
                    Gio.DBusCallFlags.NONE,
                    250,
                    None,
                )
            except Exception:
                pass
            self._toast(
                "AC: Never Sleep (10m DPMS) · Battery: 2m Blank / 5m Sleep"
                if state
                else "AC: Never Sleep (10m DPMS) · Battery: 5m Blank / 15m Sleep"
            )
            return False
        try:
            sess = Gio.Settings.new("org.gnome.desktop.session")
            pwr = Gio.Settings.new("org.gnome.settings-daemon.plugins.power")
            pwr.set_string("sleep-inactive-ac-type", "nothing")
            if state:
                sess.set_uint("idle-delay", 120)
                pwr.set_int("sleep-inactive-battery-timeout", 300)
                self._toast("AC: Never Sleep · Battery: 2m blank / 5m sleep")
            else:
                sess.set_uint("idle-delay", 300)
                pwr.set_int("sleep-inactive-battery-timeout", 900)
                self._toast("AC: Never Sleep · Battery: 5m blank / 15m sleep")
        except Exception:
            pass
        return False

    def _on_orient_toggled(self, _sw, state):
        if self._switches_updating:
            return False
        try:
            ts = Gio.Settings.new("org.gnome.settings-daemon.peripherals.touchscreen")
            ts.set_boolean("orientation-lock", bool(state))
            self._toast("Landscape orientation locked" if state else "Auto-rotation enabled")
        except Exception:
            pass
        return False

    def _on_instant_wake_toggled(self, _sw, state):
        if self._switches_updating:
            return False
        try:
            ss = Gio.Settings.new("org.gnome.desktop.screensaver")
            ss.set_boolean("lock-enabled", not bool(state))
            self._toast(
                "Instant wake enabled (resumes straight to desktop/game)"
                if state
                else "Password lock on sleep re-enabled"
            )
        except Exception:
            pass
        return False

    def _resolve_repo_info(self):
        repo_dir = Path.home() / "msi-claw-center"
        try:
            script_real = Path(__file__).resolve()
            if (script_real.parent.parent / ".git").exists():
                repo_dir = script_real.parent.parent
        except Exception:
            pass
        remote_url = ""
        if (repo_dir / ".git").exists():
            try:
                out = subprocess.check_output(
                    ["git", "-C", str(repo_dir), "remote", "get-url", "origin"],
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=0.5,
                ).strip()
                if out.startswith("git@github.com:"):
                    out = "https://github.com/" + out[len("git@github.com:") :]
                if out.endswith(".git"):
                    out = out[:-4]
                if out.startswith("http://") or out.startswith("https://"):
                    remote_url = out
            except Exception:
                pass
        return repo_dir, remote_url

    def _get_repo_button_label(self):
        _repo_dir, remote_url = self._resolve_repo_info()
        return "Open GitHub Repository" if remote_url else "Open Source Repo (~/msi-claw-center)"

    def _on_open_repo(self, _btn):
        repo_dir, remote_url = self._resolve_repo_info()
        target_uri = remote_url if remote_url else repo_dir.as_uri()
        try:
            Gio.AppInfo.launch_default_for_uri(target_uri, None)
            self._toast("Opening GitHub repository..." if remote_url else f"Opened {repo_dir}")
        except Exception as e:
            self._toast(f"Could not open repository: {e}")

    def _on_show_about(self, _btn):
        repo_dir, remote_url = self._resolve_repo_info()
        website = remote_url if remote_url else repo_dir.as_uri()
        try:
            about = Adw.AboutDialog(
                application_name="MSI Claw Center",
                application_icon="input-gaming-symbolic",
                version="1.2.0",
                comments=(
                    "Native GTK4 / Libadwaita Handheld & Mini-PC Control Center for MSI Claw A1M "
                    "(Intel Core Ultra 7 155H · KDE Plasma 6 & GNOME Wayland).\n\n"
                    f"Local repository: {repo_dir}"
                ),
                website=website,
                license_type=Gtk.License.GPL_3_0,
            )
            about.present(self)
        except Exception:
            self._on_open_repo(None)

    def _on_enable_fingerprint(self, _btn):
        try:
            cmd = (
                ["systemsettings", "kcm_users"]
                if self._is_plasma() and os.path.exists("/usr/bin/systemsettings")
                else ["gnome-control-center", "system", "users"]
            )
            Gio.Subprocess.new(
                cmd,
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            self._toast("Goodix MOC Fingerprint Sensor ready — enroll fingerprint in Users settings")
        except Exception as e:
            self._toast(f"Error opening Users settings: {e}")

    def _on_scx_mode_clicked(self, _btn, mode):
        script = "/usr/local/sbin/msi-claw-system-power-setup.sh"
        try:
            if os.path.exists("/usr/bin/scxctl"):
                if mode == "off":
                    cmd = ["scxctl", "stop"]
                else:
                    scx_state = read_sysfs("/sys/kernel/sched_ext/state", "disabled")
                    sub = "switch" if scx_state == "enabled" else "start"
                    cmd = ["scxctl", sub, "--sched", "scx_lavd", "--mode", mode]
            else:
                cmd = ["pkexec", script, "--scx", mode]
            proc = Gio.Subprocess.new(
                cmd,
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.wait_check_async(
                None,
                lambda p, r: (
                    self._toast(
                        f"Scheduler: {'Kernel EEVDF' if mode == 'off' else f'scx_lavd ({mode})'}"
                        if self._finish_ok(p, r)
                        else "Scheduler switch failed"
                    ),
                    GLib.timeout_add(300, lambda: (self._refresh_telemetry(), GLib.SOURCE_REMOVE)[1]),
                ),
            )
        except Exception as e:
            self._toast(f"Scheduler error: {e}")

    def _on_gpu_priority_clicked(self, _btn):
        target = "off" if gpu_priority_active() else "on"
        script = "/usr/local/sbin/msi-claw-system-power-setup.sh"
        try:
            proc = Gio.Subprocess.new(
                ["pkexec", script, "--gpu-priority", target],
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.wait_check_async(
                None,
                lambda p, r: (
                    self._toast(
                        "GPU Priority ON (CPU capped ~3.45 GHz)"
                        if target == "on" and self._finish_ok(p, r)
                        else ("Full CPU Boost (100%) restored" if self._finish_ok(p, r) else "Canceled")
                    ),
                    self._refresh_telemetry(),
                ),
            )
        except Exception as e:
            self._toast(f"Error: {e}")

    def _on_apply_live_fixes(self, _btn):
        script = "/usr/local/sbin/msi-claw-system-power-setup.sh"
        try:
            proc = Gio.Subprocess.new(
                ["pkexec", script, "--fix-all-live"],
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.wait_check_async(
                None,
                lambda p, r: (
                    self._toast(
                        "Live TuneD, LPMD, zstd zram & scx_lavd applied!"
                        if self._finish_ok(p, r)
                        else "Live fix canceled"
                    ),
                    self._refresh_telemetry(),
                ),
            )
        except Exception as e:
            self._toast(f"Error: {e}")

    def _on_reapply_system_setup(self, _btn):
        script = "/usr/local/sbin/msi-claw-system-power-setup.sh"
        try:
            proc = Gio.Subprocess.new(
                ["pkexec", script],
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.wait_check_async(
                None,
                lambda p, r: (
                    self._toast("System power & GDM OSK setup applied!" if self._finish_ok(p, r) else "Setup canceled"),
                    self._refresh_telemetry(),
                ),
            )
        except Exception as e:
            self._toast(f"Error: {e}")

    def _on_charge_limit_clicked(self, _btn, pct):
        helper = "/usr/local/sbin/msi-claw-battery-limit"
        try:
            proc = Gio.Subprocess.new(
                ["pkexec", helper, "set", str(pct)],
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.wait_check_async(
                None,
                lambda p, r: (
                    self._toast(
                        f"Battery Charge Limit set to {pct}% (EC 0xD7)"
                        if self._finish_ok(p, r)
                        else f"Failed to set {pct}% charge limit"
                    ),
                    GLib.timeout_add(400, lambda: (self._refresh_telemetry(), GLib.SOURCE_REMOVE)[1]),
                ),
            )
            self._update_charge_limit_highlights(pct)
        except Exception as e:
            self._toast(f"Battery limit error: {e}")

    def _update_charge_limit_highlights(self, active_pct):
        for pct, btn in self.charge_limit_buttons.items():
            btn.remove_css_class("eco-active")
            btn.remove_css_class("active-mode")
            btn.remove_css_class("perf-active")
            if pct == active_pct:
                if pct <= 60:
                    btn.add_css_class("eco-active")
                else:
                    btn.add_css_class("active-mode")

    def _refresh_telemetry(self):
        # 1. AC / Battery / Dock Telemetry
        ac_online = read_sysfs("/sys/class/power_supply/ADP1/online", "1") == "1"
        bat = "/sys/class/power_supply/BAT1"
        cap = read_sysfs(f"{bat}/capacity", "--")
        status = read_sysfs(f"{bat}/status", "Unknown")
        dock_raw = read_sysfs(f"/dev/shm/msi-claw-dock-{os.getuid()}", "handheld")
        is_docked = dock_raw.startswith("docked")
        chg_limit_txt = read_sysfs("/run/msi-claw-charge-limit", "") or read_sysfs("/var/lib/msi-claw/charge-limit", "100")
        try:
            chg_limit = int(chg_limit_txt)
        except ValueError:
            chg_limit = 100
        self._update_charge_limit_highlights(chg_limit)

        if ac_online:
            if is_docked:
                dock_conn = dock_raw.split(":", 1)[1] if ":" in dock_raw else "Dock"
                if status in ("Not charging", "Full"):
                    self.power_badge.set_label(f"Docked ({dock_conn}) · AC Bypass")
                else:
                    self.power_badge.set_label(f"Docked ({dock_conn}) · Charging")
            else:
                self.power_badge.set_label("AC Charging" if status == "Charging" else "AC Bypass")
            self.power_badge.remove_css_class("badge-bat")
            self.power_badge.add_css_class("badge-ac")
        else:
            self.power_badge.set_label("On Battery")
            self.power_badge.remove_css_class("badge-ac")
            self.power_badge.add_css_class("badge-bat")

        cur_ua = abs(float(read_sysfs(f"{bat}/current_now", "0") or 0))
        volt_uv = float(read_sysfs(f"{bat}/voltage_now", "0") or 0)
        pwr_uw = read_sysfs(f"{bat}/power_now", "")
        chg_now = float(read_sysfs(f"{bat}/charge_now", "0") or 0)
        chg_full = float(read_sysfs(f"{bat}/charge_full", "4707000") or 4707000)
        chg_des = float(read_sysfs(f"{bat}/charge_full_design", "4550000") or 4550000)
        volt_des = float(read_sysfs(f"{bat}/voltage_min_design", "11550000") or 11550000) / 1e6

        watts = (abs(float(pwr_uw)) / 1e6) if pwr_uw else ((cur_ua * volt_uv) / 1e12)
        eta_str = ""
        if cur_ua > 50000 and status in ("Charging", "Discharging"):
            target_chg = chg_full * (chg_limit / 100.0) if status == "Charging" else 0.0
            hrs = (max(0.0, target_chg - chg_now) / cur_ua) if status == "Charging" else (chg_now / cur_ua)
            if 0 < hrs < 30:
                eta_str = f"{int(hrs)}h {int((hrs % 1) * 60):02d}m {'to cap' if status == 'Charging' else 'left'} · "
        health = min(100, round((chg_full / max(1.0, chg_des)) * 100))
        wh_full = (chg_full * volt_des) / 1e6

        if ac_online and status in ("Not charging", "Full") and watts < 0.2:
            self.bat_val.set_label(f"{cap}% · AC Bypass (0.0W)")
        else:
            self.bat_val.set_label(f"{cap}% · {status} {watts:.1f}W")
        self.bat_sub.set_label(f"{eta_str}Cap {chg_limit}% · Health {health}% ({wh_full:.1f} Wh)")

        # 2. CPU, RAPL TDP & Uncore
        t_mc = float(read_sysfs(self.cpu_temp_path, "0") or 0)
        pl1_msr = float(read_sysfs("/sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw", "28000000") or 0) / 1e6
        pl1_mmio = float(read_sysfs("/sys/class/powercap/intel-rapl-mmio:0/constraint_0_power_limit_uw", "35000000") or 0) / 1e6
        pl2_msr = float(read_sysfs("/sys/class/powercap/intel-rapl:0/constraint_1_power_limit_uw", "35000000") or 0) / 1e6
        pl2_mmio = float(read_sysfs("/sys/class/powercap/intel-rapl-mmio:0/constraint_1_power_limit_uw", "43000000") or 0) / 1e6
        eff_pl1 = int(round(min(pl1_msr, pl1_mmio)))
        eff_pl2 = int(round(min(pl2_msr, pl2_mmio)))
        uncore_ghz = float(read_sysfs("/sys/devices/system/cpu/intel_uncore_frequency/package_00_die_00/max_freq_khz", "2800000") or 0) / 1e6
        epp = read_sysfs("/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference", "balance")
        max_pct = int(read_sysfs("/sys/devices/system/cpu/intel_pstate/max_perf_pct", "100") or 100)

        self.cpu_val.set_label(f"{t_mc / 1000.0:.0f}°C · {eff_pl1}W / {eff_pl2}W")
        self.cpu_sub.set_label(f"Uncore {uncore_ghz:.1f}G · Cap {max_pct}% · {epp}")

        if gpu_priority_active():
            self.gpu_prio_btn.add_css_class("eco-active")
            self.gpu_prio_btn.set_label(f"GPU Priority Active · CPU Cap {max_pct}% (~3.45 GHz)")
        else:
            self.gpu_prio_btn.remove_css_class("eco-active")
            self.gpu_prio_btn.set_label(f"Gaming GPU Priority · Cap CPU Boost (Now {max_pct}%)")

        # sched_ext & Live System Status Banner
        scx_state = read_sysfs("/sys/kernel/sched_ext/state", "disabled")
        scx_ops = read_sysfs("/sys/kernel/sched_ext/root/ops", "") if scx_state == "enabled" else ""
        clean_ops = re.sub(r"^scx_", "", scx_ops.strip())
        base_ops = re.split(r"[\s_-]+", clean_ops)[0] if clean_ops else ""
        sched_lbl = f"scx_{base_ops}" if base_ops else "EEVDF"

        def apply_scx_highlight(mode_idx):
            for smode, sbtn in self.scx_buttons.items():
                sbtn.remove_css_class("active-mode")
                sbtn.remove_css_class("perf-active")
                if scx_state != "enabled" and smode == "off":
                    sbtn.add_css_class("active-mode")
                elif scx_state == "enabled":
                    if smode == "gaming" and mode_idx == 1:
                        sbtn.add_css_class("perf-active")
                    elif smode == "auto" and mode_idx != 1:
                        sbtn.add_css_class("active-mode")

        def on_got_scx_mode(bus, res):
            try:
                apply_scx_highlight(int(bus.call_finish(res).unpack()[0]))
            except Exception:
                apply_scx_highlight(0)

        if scx_state == "enabled":
            try:
                self.sys_bus.call(
                    "org.scx.Loader",
                    "/org/scx/Loader",
                    "org.freedesktop.DBus.Properties",
                    "Get",
                    GLib.Variant("(ss)", ("org.scx.Loader", "SchedulerMode")),
                    GLib.VariantType.new("(v)"),
                    Gio.DBusCallFlags.NONE,
                    200,
                    None,
                    on_got_scx_mode,
                )
            except Exception:
                apply_scx_highlight(0)
        else:
            apply_scx_highlight(0)

        zram_raw = read_sysfs("/sys/block/zram0/comp_algorithm", "[lzo-rle]")
        zram_m = re.search(r"\[([^\]]+)\]", zram_raw)
        zram_alg = zram_m.group(1) if zram_m else zram_raw
        nvme_raw = read_sysfs("/sys/block/nvme0n1/queue/scheduler", "[none]")
        nvme_m = re.search(r"\[([^\]]+)\]", nvme_raw)
        nvme_sched = nvme_m.group(1) if nvme_m else nvme_raw
        d3c = read_sysfs("/sys/bus/pci/devices/0000:2b:00.0/d3cold_allowed", "0")
        self.sys_status_lbl.set_label(
            f"Sched: {sched_lbl} · zram: {zram_alg} · NVMe: {nvme_sched} · Audio Headroom: 1024 · BE200 D3cold={d3c}"
        )

        # Active PPD Profile highlight (async call)
        def on_got_profile(bus, res):
            try:
                reply = bus.call_finish(res)
                active_prof = reply.unpack()[0]
                self._update_power_highlights(active_prof)
            except Exception:
                pass

        try:
            self.sys_bus.call(
                "org.freedesktop.UPower.PowerProfiles",
                "/org/freedesktop/UPower/PowerProfiles",
                "org.freedesktop.DBus.Properties",
                "Get",
                GLib.Variant("(ss)", ("org.freedesktop.UPower.PowerProfiles", "ActiveProfile")),
                GLib.VariantType.new("(v)"),
                Gio.DBusCallFlags.NONE,
                300,
                None,
                on_got_profile,
            )
        except Exception:
            pass

        # 3. Intel Arc GPU RC6 & SLPC
        now_ts = time.monotonic()
        rc6_ms = float(read_sysfs("/sys/class/drm/card1/gt/gt0/rc6_residency_ms", "0") or 0)
        rc6_str = "RC6 --%"
        if self._last_rc6_ms is not None and self._last_rc6_ts is not None:
            dt_ms = (now_ts - self._last_rc6_ts) * 1000.0
            if dt_ms > 100:
                pct = max(0.0, min(100.0, ((rc6_ms - self._last_rc6_ms) / dt_ms) * 100.0))
                rc6_str = f"RC6 {pct:.1f}%"
        self._last_rc6_ms = rc6_ms
        self._last_rc6_ts = now_ts

        slpc_raw = read_sysfs("/sys/class/drm/card1/gt/gt0/slpc_power_profile", "[base]")
        slpc_m = re.search(r"\[([^\]]+)\]", slpc_raw)
        slpc = slpc_m.group(1) if slpc_m else slpc_raw
        boost_mhz = read_sysfs("/sys/class/drm/card1/gt/gt0/rps_boost_freq_mhz", "--")
        self.gpu_val.set_label(f"{rc6_str} · {boost_mhz} MHz")
        self.gpu_sub.set_label(f"SLPC: {slpc} · GT0/GT1 Active")

        # 4. Cooling Fans & Controller Mode
        f1 = read_sysfs(self.fan1_path, "0")
        f2 = read_sysfs(self.fan2_path, "0")
        self.fan_val.set_label(f"{f1} / {f2} RPM")
        self._refresh_controller_mode()


class MSIClawCenterApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="io.msiclaw.Center",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
        )

    def do_startup(self):
        Adw.Application.do_startup(self)
        self.hold()  # Prevent automatic exit when window is hidden/unmapped
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        provider = Gtk.CssProvider()
        provider.load_from_string(APP_CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        # Register application actions
        toggle_action = Gio.SimpleAction.new("toggle", None)
        toggle_action.connect("activate", lambda *_: self.toggle_window())
        self.add_action(toggle_action)

        hide_action = Gio.SimpleAction.new("hide", None)
        hide_action.connect("activate", lambda *_: self.hide_window())
        self.add_action(hide_action)

        show_action = Gio.SimpleAction.new("show", None)
        show_action.connect("activate", lambda *_: self.show_window())
        self.add_action(show_action)

        quit_action = Gio.SimpleAction.new("quit", None)
        quit_action.connect("activate", lambda *_: self._on_quit_action())
        self.add_action(quit_action)

    def _on_quit_action(self):
        try:
            while self.get_hold_count() > 0:
                self.release()
        except Exception:
            pass
        self.quit()

    def get_or_create_window(self):
        windows = self.get_windows()
        if windows:
            return windows[0]
        return MSIClawCenterWindow(self)

    def show_window(self):
        win = self.get_or_create_window()
        win.set_visible(True)
        win.unminimize()
        win.present()
        return win

    def hide_window(self):
        windows = self.get_windows()
        if windows:
            windows[0]._stop_polling()
            windows[0].set_visible(False)

    def toggle_window(self):
        windows = self.get_windows()
        if not windows:
            self.show_window()
            return
        win = windows[0]
        if win.get_visible() and win.is_active():
            win._stop_polling()
            win.set_visible(False)
        else:
            win.set_visible(True)
            win.unminimize()
            win.present()

    def do_activate(self):
        self.show_window()

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        if "--toggle" in args or "-t" in args:
            self.toggle_window()
        elif "--hide" in args:
            self.hide_window()
        elif "--show" in args or "--present" in args:
            self.show_window()
        elif "--background" in args or "--daemon" in args:
            win = self.get_or_create_window()
            win.set_visible(False)
        elif "--quit" in args or "-q" in args:
            self._on_quit_action()
        elif "--status" in args:
            cpu_t, f1, f2 = resolve_hwmon()
            bat_cap = read_sysfs("/sys/class/power_supply/BAT1/capacity", "--")
            bat_status = read_sysfs("/sys/class/power_supply/BAT1/status", "Unknown")
            chg_lim = read_sysfs("/run/msi-claw-charge-limit", "") or read_sysfs("/var/lib/msi-claw/charge-limit", "100")
            ctrl_mode = read_sysfs(f"/dev/shm/msi-claw-mode-{os.getuid()}", "desktop")
            dock_mode = read_sysfs(f"/dev/shm/msi-claw-dock-{os.getuid()}", "handheld")
            status_obj = {
                "battery": f"{bat_cap}% ({bat_status})",
                "charge_limit": f"{chg_lim}%",
                "dock_state": dock_mode,
                "cpu_temp": f"{float(read_sysfs(cpu_t, '0') or 0)/1000:.1f}°C",
                "fans_rpm": f"{read_sysfs(f1, '0')}/{read_sysfs(f2, '0')}",
                "controller_mode": ctrl_mode,
            }
            command_line.print_literal(json.dumps(status_obj, indent=2) + "\n")
        elif "--help" in args or "-h" in args:
            help_txt = (
                "MSI Claw Center\n"
                "Usage:\n"
                "  msi-claw-center [OPTION...]\n\n"
                "Options:\n"
                "  -t, --toggle    Toggle MSI Claw Center window overlay (show/hide)\n"
                "  --show          Present MSI Claw Center window\n"
                "  --hide          Hide MSI Claw Center window\n"
                "  --background    Start daemon in background with hidden window\n"
                "  -q, --quit      Quit MSI Claw Center\n"
                "  --status        Print quick handheld telemetry summary (JSON)\n"
                "  -h, --help      Show this help message\n"
            )
            command_line.print_literal(help_txt)
        else:
            self.show_window()
        return 0


def main():
    app = MSIClawCenterApp()
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()
