[Unit]
Description=MSI Claw Center Handheld Power, Display & RGB GUI Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=GSK_RENDERER=cairo
ExecStart=%h/.local/bin/msi-claw-center --background
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
